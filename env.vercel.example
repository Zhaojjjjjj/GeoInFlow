# GEOInflow Vercel edition - environment variables
# Copy these into Vercel Project Settings -> Environment Variables.
# See README-VERCEL.md for the full guide. Never commit real values.

# --- PostgreSQL (required) ---
# Use the Supabase *Session pooler* URL (port 5432, host *.pooler.supabase.com).
# pg-boss needs session-level features, so do NOT use the transaction
# pooler (port 6543) for the runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection string, used only by `pnpm vercel:bootstrap` (migrations).
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Application secrets (required) ---
# Generate each with: openssl rand -hex 32
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=

# --- Redis (required for login sessions and share rate limiting) ---
# Upstash Redis connection string (rediss://...).
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# Analytics cache; can be the same Upstash database.
LIEKAN_ANALYTICS_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# --- Worker bursts (required) ---
# Random secret protecting /api/cron/*; also set it as a GitHub Actions
# secret with the same value (and APP_URL) so the scheduled workflow can
# wake the workers. Generate with: openssl rand -hex 32
CRON_SECRET=
# Seconds each cron invocation keeps processing queued jobs (5-280).
# 50 fits the Hobby plan function limit; raise to 240 on Pro.
WORKER_BURST_SECONDS=50

# --- Product defaults ---
DEFAULT_LOCALE=zh-CN
DISABLE_TELEMETRY=1
NEXT_TELEMETRY_DISABLED=1
API_KEY_ENABLED=1

# --- Public URL (needed for automatic log ingestion / OAuth callbacks) ---
LIEKAN_PUBLIC_URL=https://your-domain.example.com

# --- Optional: automatic log ingestion credential encryption ---
# Generate with: openssl rand -base64 32
LIEKAN_LOG_CREDENTIALS_KEY=

# --- Optional: AI analysis (disabled by default) ---
LIEKAN_AI_ENABLED=false
LIEKAN_AI_ENCRYPTION_KEY=
